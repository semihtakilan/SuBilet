@model IEnumerable<SuBilet.Models.Sefer>

@{
    ViewData["Title"] = "Sefer Listesi";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Sefer Listesi</h2>
        <a asp-action="Create" class="btn btn-primary">+ Yeni Sefer Ekle</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Firma</th>
                    <th>Otobüs</th>
                    <th>Kalkış Şehri</th>
                    <th>Varış Şehri</th>
                    <th>Kalkış Zamanı</th>
                    <th>Tahmini Varış</th>
                    <th>Fiyat</th>
                    <th>Durum</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Firma?.Ad</td>
                        <td>@item.Otobus?.Plaka</td>
                        <td>@item.KalkisSehir?.Ad</td>
                        <td>@item.VarisSehir?.Ad</td>
                        <td>@item.KalkisZamani?.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@item.TahminiVarisZamani?.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@item.Fiyat?.ToString("N2") TL</td>
                        <td><span class="badge bg-secondary">@item.Durum</span></td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Düzenle</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger ms-1">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>