@model SuBilet.Models.Sefer

@{
    ViewData["Title"] = "Yeni Sefer Ekle";
}

<div class="container py-4">
    <h2>Yeni Sefer Ekle</h2>
    <hr />

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="FirmaId" class="form-label"></label>
                <select asp-for="FirmaId" asp-items="ViewBag.Firmalar" class="form-select">
                    <option value="">-- Firma Seçin --</option>
                </select>
                <span asp-validation-for="FirmaId" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="OtobusId" class="form-label"></label>
                <select asp-for="OtobusId" asp-items="ViewBag.Otobusler" class="form-select">
                    <option value="">-- Otobüs Seçin --</option>
                </select>
                <span asp-validation-for="OtobusId" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="KalkisSehirId" class="form-label"></label>
                <select asp-for="KalkisSehirId" asp-items="ViewBag.Sehirler" class="form-select">
                    <option value="">-- Kalkış Şehri Seçin --</option>
                </select>
                <span asp-validation-for="KalkisSehirId" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="VarisSehirId" class="form-label"></label>
                <select asp-for="VarisSehirId" asp-items="ViewBag.Sehirler" class="form-select">
                    <option value="">-- Varış Şehri Seçin --</option>
                </select>
                <span asp-validation-for="VarisSehirId" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="KalkisZamani" class="form-label"></label>
                <input asp-for="KalkisZamani" type="datetime-local" class="form-control" />
                <span asp-validation-for="KalkisZamani" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="TahminiVarisZamani" class="form-label"></label>
                <input asp-for="TahminiVarisZamani" type="datetime-local" class="form-control" />
                <span asp-validation-for="TahminiVarisZamani" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Fiyat" class="form-label"></label>
                <input asp-for="Fiyat" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Fiyat" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Durum" class="form-label"></label>
                <select asp-for="Durum" asp-items="Html.GetEnumSelectList<SuBilet.Models.SeferDurumu>()" class="form-select"></select>
                <span asp-validation-for="Durum" class="text-danger"></span>
            </div>
        </div>

        <button type="submit" class="btn btn-success">Kaydet</button>
        <a asp-action="Index" class="btn btn-secondary">İptal</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}