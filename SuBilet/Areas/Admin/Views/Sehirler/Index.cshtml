@model List<Sehir>
@{
    ViewData["Title"] = "Şehirler";
}

<div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
    <form method="get" class="d-flex gap-2 flex-grow-1" style="max-width: 28rem;">
        <input type="search" name="arama" value="@ViewData["Arama"]" class="form-control" placeholder="Şehir adı ya da plaka kodu" />
        <button type="submit" class="btn btn-outline-secondary">Ara</button>
    </form>
    <a asp-action="Ekle" class="btn btn-primary">Yeni Şehir</a>
</div>

<div class="sb-tablo table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th style="width: 6rem;">Plaka</th>
                <th>Şehir</th>
                <th class="text-end">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sehir in Model)
            {
                <tr>
                    <td>@sehir.PlakaKodu?.ToString("00")</td>
                    <td>@sehir.Ad</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Duzenle" asp-route-id="@sehir.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                        <a asp-action="Sil" asp-route-id="@sehir.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="3" class="text-center text-body-secondary py-4">Kayıt bulunamadı.</td></tr>
            }
        </tbody>
    </table>
</div>
<p class="small text-body-secondary mt-2">@Model.Count şehir listelendi.</p>
