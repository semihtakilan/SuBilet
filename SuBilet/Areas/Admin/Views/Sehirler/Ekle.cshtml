@model Sehir
@{
    ViewData["Title"] = "Yeni Şehir";
}

<div class="sb-kart" style="max-width: 40rem;">
    <h2 class="h5 mb-3">Yeni Şehir</h2>
    <form asp-action="Ekle" method="post">
        <partial name="_Form" model="Model" />
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
