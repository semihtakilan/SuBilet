@model Sehir
@{
    ViewData["Title"] = "Yeni Şehir";
    var bosPlakaKodlari = ViewData["BosPlakaKodlari"] as List<int> ?? new();
}

<div class="sb-kart" style="max-width: 40rem;">
    <h2 class="h5 mb-3">Yeni Şehir</h2>
    <form asp-action="Ekle" method="post">
        <partial name="_Form" model="Model" />
        <div class="form-text mt-2">
            @if (bosPlakaKodlari.Count == 0)
            {
                <text>Tüm plaka kodları (1–81) kullanımda; yeni şehir eklemek için önce listeden bir şehri silmeniz gerekir.</text>
            }
            else
            {
                <text>Boş plaka kodları: @string.Join(", ", bosPlakaKodlari)</text>
            }
        </div>
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
