@model Otobus
@{
    ViewData["Title"] = "Otobüs Sil";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h4 mb-0 text-danger">Otobüs Silme Onayı</h2>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Listeye Dön</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <div class="alert alert-warning mb-4">
            Bu otobüsü silmek istediğinize emin misiniz? Otobüse bağlı seferler varsa işlem başarısız olabilir.
        </div>

        <dl class="row mb-4">
            <dt class="col-sm-3 text-muted">Plaka</dt>
            <dd class="col-sm-9 fw-bold">@Model.Plaka</dd>

            <dt class="col-sm-3 text-muted">Firma</dt>
            <dd class="col-sm-9">@Model.Firma?.Ad</dd>

            <dt class="col-sm-3 text-muted">Koltuk Düzeni</dt>
            <dd class="col-sm-9">@Model.KoltukDuzeni</dd>

            <dt class="col-sm-3 text-muted">Koltuk Sayısı</dt>
            <dd class="col-sm-9">@Model.KoltukSayisi</dd>
        </dl>

        <form asp-action="SilOnay" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Evet, Sil</button>
            <a asp-action="Index" class="btn btn-light border ms-2">Vazgeç</a>
        </form>
    </div>
</div>