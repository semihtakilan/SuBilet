@model IEnumerable<Otobus>
@{
    ViewData["Title"] = "Otobüsler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h4 mb-1">Otobüs Listesi</h2>
        <p class="text-muted small mb-0">Firmalara ait otobüsleri ve kapasitelerini yönetin.</p>
    </div>
    <a asp-action="Ekle" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i> Yeni Otobüs
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Plaka</th>
                        <th>Firma</th>
                        <th>Koltuk Düzeni</th>
                        <th>Koltuk Sayısı</th>
                        <th class="text-end pe-3">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">@item.Plaka</td>
                                <td>@item.Firma?.Ad</td>
                                <td>
                                    <span class="badge bg-secondary">@item.KoltukDuzeni</span>
                                </td>
                                <td>@item.KoltukSayisi</td>
                                <td class="text-end pe-3">
                                    <a asp-action="Duzenle" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">Düzenle</a>
                                    <a asp-action="Sil" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">Kayıtlı otobüs bulunamadı.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>