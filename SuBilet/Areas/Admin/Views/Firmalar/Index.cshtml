@model List<FirmaSatiri>
@{
    ViewData["Title"] = "Firmalar";
}

<div class="sb-tablo table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Firma</th>
                <th class="d-none d-md-table-cell">İletişim</th>
                <th class="text-center">Otobüs</th>
                <th class="text-center">Sefer</th>
                <th>Durum</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var satir in Model)
            {
                var firma = satir.Firma;
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            @if (!string.IsNullOrEmpty(firma.LogoUrl))
                            {
                                <img src="@firma.LogoUrl" alt="" class="sb-logo-kucuk" loading="lazy" />
                            }
                            <a asp-action="Detay" asp-route-id="@firma.Id">@firma.Ad</a>
                        </div>
                    </td>
                    <td class="d-none d-md-table-cell small">
                        @firma.Telefon<br /><span class="text-body-secondary">@firma.Eposta</span>
                    </td>
                    <td class="text-center">@satir.OtobusSayisi</td>
                    <td class="text-center">@satir.SeferSayisi</td>
                    <td>
                        @if (firma.AktifMi)
                        {
                            <span class="badge text-bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Pasif</span>
                        }
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-body-secondary py-4">Henüz firma yok.</td></tr>
            }
        </tbody>
    </table>
</div>
