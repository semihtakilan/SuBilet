@model Firma
@* Ekle ve Düzenle sayfalarının ortak alanları *@
<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
<div class="row g-3">
    <div class="col-12">
        <label asp-for="Ad" class="form-label"></label>
        <input asp-for="Ad" class="form-control" />
        <span asp-validation-for="Ad" class="text-danger small"></span>
    </div>
    <div class="col-12 col-md-6">
        <label asp-for="Telefon" class="form-label"></label>
        <input asp-for="Telefon" class="form-control" placeholder="0212 555 01 01" />
        <span asp-validation-for="Telefon" class="text-danger small"></span>
    </div>
    <div class="col-12 col-md-6">
        <label asp-for="Eposta" class="form-label"></label>
        <input asp-for="Eposta" class="form-control" />
        <span asp-validation-for="Eposta" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <label asp-for="LogoUrl" class="form-label"></label>
        <input asp-for="LogoUrl" class="form-control" placeholder="https://..." />
        <span asp-validation-for="LogoUrl" class="text-danger small"></span>
    </div>
    <div class="col-12">
        <div class="form-check form-switch">
            <input asp-for="AktifMi" class="form-check-input" role="switch" />
            <label asp-for="AktifMi" class="form-check-label"></label>
        </div>
        <div class="form-text">Pasif firmalara yeni otobüs ve sefer eklenemez.</div>
    </div>
</div>
