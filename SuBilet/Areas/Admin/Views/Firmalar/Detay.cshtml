@model Firma
@{
    ViewData["Title"] = Model.Ad;
    var seferSayisi = (int)(ViewData["SeferSayisi"] ?? 0);
    var yaklasanSeferSayisi = (int)(ViewData["YaklasanSeferSayisi"] ?? 0);
}

<div class="row g-3">
    <div class="col-12 col-lg-5">
        <div class="sb-kart h-100">
            <div class="d-flex align-items-center gap-2 mb-3">
                @if (!string.IsNullOrEmpty(Model.LogoUrl))
                {
                    <img src="@Model.LogoUrl" alt="" class="sb-logo-kucuk" />
                }
                <h2 class="h5 mb-0">@Model.Ad</h2>
                @if (Model.AktifMi)
                {
                    <span class="badge text-bg-success ms-auto">Aktif</span>
                }
                else
                {
                    <span class="badge text-bg-secondary ms-auto">Pasif</span>
                }
            </div>
            <dl class="row mb-0">
                <dt class="col-4">Telefon</dt>
                <dd class="col-8">@Model.Telefon</dd>
                <dt class="col-4">E-posta</dt>
                <dd class="col-8 text-break">@Model.Eposta</dd>
                <dt class="col-4">Sefer</dt>
                <dd class="col-8">@seferSayisi <span class="text-body-secondary small">(@yaklasanSeferSayisi yaklaşan)</span></dd>
                <dt class="col-4">Yetkililer</dt>
                <dd class="col-8">
                    @if (Model.Kullanicilar.Count == 0)
                    {
                        <span class="text-body-secondary">Atanmış yetkili yok</span>
                    }
                    @foreach (var yetkili in Model.Kullanicilar)
                    {
                        <div>@yetkili.AdSoyad <span class="text-body-secondary small">(@yetkili.Email)</span></div>
                    }
                </dd>
            </dl>
            <div class="mt-3 d-flex gap-2">
                <a asp-action="Duzenle" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                <a asp-action="Index" class="btn btn-sm btn-secondary">Listeye dön</a>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-7">
        <div class="sb-kart h-100">
            <h3 class="h6 mb-3">Otobüsler (@Model.Otobusler.Count)</h3>
            @if (Model.Otobusler.Count == 0)
            {
                <p class="text-body-secondary mb-0">Bu firmaya ait otobüs yok.</p>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var otobus in Model.Otobusler.OrderBy(o => o.Plaka))
                    {
                        <li class="list-group-item px-0 d-flex justify-content-between">
                            <span>@otobus.Plaka</span>
                            <span class="text-body-secondary small">@otobus.KoltukSayisi koltuk</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>
