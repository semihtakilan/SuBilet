@model FirmaSatiri
@{
    ViewData["Title"] = "Firma Sil";
    var firma = Model.Firma;
}

<div class="sb-kart" style="max-width: 40rem;">
    <h2 class="h5 mb-3">Firma Sil</h2>
    @if (Model.OtobusSayisi > 0 || Model.SeferSayisi > 0)
    {
        <div class="alert alert-warning">
            <strong>@firma.Ad</strong> firmasının @Model.OtobusSayisi otobüsü ve @Model.SeferSayisi seferi var; silinemez.
            Firmayı düzenleyip pasif yapabilirsiniz.
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Duzenle" asp-route-id="@firma.Id" class="btn btn-primary">Düzenle</a>
            <a asp-action="Index" class="btn btn-secondary">Listeye dön</a>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <strong>@firma.Ad</strong> silinecek. Emin misiniz?
            @if (Model.YetkiliSayisi > 0)
            {
                <div class="mt-2 small">Bu firmaya bağlı @Model.YetkiliSayisi yetkilinin firma bağlantısı kaldırılacak.</div>
            }
        </div>
        <form asp-action="Sil" asp-route-id="@firma.Id" method="post" class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Evet, sil</button>
            <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
        </form>
    }
</div>
