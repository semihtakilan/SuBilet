@model SuBilet.Models.Sefer

@{
    ViewData["Title"] = "Sefer Sil";
}

<div class="container py-4">
    <h2 class="text-danger">Seferi Silmek İstediğinize Emin Misiniz?</h2>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">Firma</dt>
        <dd class="col-sm-9">@Model.Firma?.Ad</dd>

        <dt class="col-sm-3">Otobüs</dt>
        <dd class="col-sm-9">@Model.Otobus?.Plaka</dd>

        <dt class="col-sm-3">Kalkış - Varış</dt>
        <dd class="col-sm-9">@Model.KalkisSehir?.Ad -> @Model.VarisSehir?.Ad</dd>

        <dt class="col-sm-3">Kalkış Zamanı</dt>
        <dd class="col-sm-9">@Model.KalkisZamani?.ToString("dd.MM.yyyy HH:mm")</dd>

        <dt class="col-sm-3">Fiyat</dt>
        <dd class="col-sm-9">@Model.Fiyat?.ToString("N2") TL</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Evet, Sil</button>
        <a asp-action="Index" class="btn btn-secondary">İptal</a>
    </form>
</div>