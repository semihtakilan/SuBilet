@model SuBilet.Models.ViewModels.SeferAramaSonucViewModel
@{
    ViewData["Title"] = $"{Model.KalkisYeri} - {Model.VarisYeri} Seferleri";
}

<div class="container my-4">
    <div class="row">
        @if (Model.FiltrePaneli != null)
        {
            @* Mobilde panel ekran dışında açılır; bu sütun boş kalır, alt boşluk bırakılmaz. *@
            <div class="col-lg-3">
                <partial name="_SeferFiltreleri" model="Model.FiltrePaneli" />
            </div>
        }

        <div class="@(Model.FiltrePaneli != null ? "col-lg-9" : "col-12")">
            @if (Model.FiltrePaneli != null)
            {
                <partial name="_SeferAracCubugu" model="Model.FiltrePaneli" />
            }

            @if (!Model.Seferler.Any())
            {
                <div class="alert alert-info text-center py-4 my-3">
                    <p class="mb-0">Aradığınız kriterlere uygun sefer bulunamadı.</p>
                </div>
            }
            else
            {
                @* Kart alanları CSS grid ile yerleşir: mobilde firma/fiyat, saatler, bilgi/düğme üç satır;
                   geniş ekranda firma | saatler | fiyat üç sütun (site.css > Sefer kartı). *@
                <div class="d-flex flex-column gap-3">
                    @foreach (var sefer in Model.Seferler)
                    {
                        var dolu = sefer.BosKoltukSayisi <= 0;
                        <article class="sb-sefer-kart">
                            <div class="sb-sefer-firma">
                                @if (!string.IsNullOrEmpty(sefer.FirmaLogoUrl))
                                {
                                    <img src="@sefer.FirmaLogoUrl" alt="" class="sb-logo-kucuk" />
                                }
                                <h2 class="sb-sefer-firma-ad">@sefer.FirmaAdi</h2>
                            </div>

                            <div class="sb-sefer-saatler">
                                <span class="sb-sefer-saat">@sefer.KalkisSaati.ToString("HH:mm")</span>
                                <span class="sb-sefer-sure">@sefer.SureMetni</span>
                                <span class="sb-sefer-saat">
                                    @sefer.VarisSaati.ToString("HH:mm")
                                    @if (sefer.VarisGunFarki > 0)
                                    {
                                        <sup class="sb-sefer-gun" title="@sefer.VarisGunFarki gün sonra varış">+@sefer.VarisGunFarki</sup>
                                    }
                                </span>
                            </div>

                            <div class="sb-sefer-fiyat">@sefer.Fiyat.ToString("C2")</div>

                            <div class="sb-sefer-bilgi">
                                <span>@sefer.KoltukDuzeni.Ad()</span>
                                @foreach (var ozellik in sefer.Ozellikler)
                                {
                                    <span>@ozellik</span>
                                }
                                <span class="@(sefer.BosKoltukSayisi <= 5 ? "text-danger fw-semibold" : "")">
                                    @(dolu ? "Dolu" : $"{sefer.BosKoltukSayisi} boş koltuk")
                                </span>
                            </div>

                            <div class="sb-sefer-dugme">
                                @if (dolu)
                                {
                                    <button type="button" class="btn btn-secondary" disabled>Dolu</button>
                                }
                                else
                                {
                                    <a href="#" class="btn btn-primary">Koltuk Seç</a>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </div>
</div>