<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ŞuBilet</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SuBilet.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-md navbar-dark sb-navbar">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <partial name="_OtobusIkonu" />
                    <span>Şu<strong>Bilet</strong></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#anaMenu"
                        aria-controls="anaMenu" aria-expanded="false" aria-label="Menüyü aç/kapat">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="anaMenu">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Otobüs Bileti</a>
                        </li>
                    </ul>
                    <partial name="_KullaniciMenusu" />
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1">
        <partial name="_Mesajlar" />
        @RenderBody()
    </main>

    <footer class="sb-footer mt-5">
        <div class="container py-4">
            <div class="row g-4">
                <div class="col-12 col-md-5">
                    <div class="fw-semibold fs-5 mb-1">Şu<strong>Bilet</strong></div>
                    <p class="mb-0 small">Türkiye genelindeki otobüs firmalarının seferleri tek bir yerde. Sefer ara, koltuğunu seç, biletini al.</p>
                </div>
                <div class="col-6 col-md-3">
                    <div class="fw-semibold mb-2">Bağlantılar</div>
                    <ul class="list-unstyled small mb-0">
                        <li><a asp-area="" asp-controller="Home" asp-action="Index">Otobüs Bileti</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Gizlilik">Gizlilik</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-4">
                    <div class="fw-semibold mb-2">İletişim</div>
                    <ul class="list-unstyled small mb-0">
                        <li>destek@subilet.example</li>
                        <li>BLM4581 dönem projesi</li>
                    </ul>
                </div>
            </div>
            <hr class="my-3" />
            <div class="small">&copy; @DateTime.Now.Year ŞuBilet</div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
