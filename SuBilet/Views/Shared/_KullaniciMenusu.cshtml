@using SuBilet.Data
@if (User.Identity?.IsAuthenticated == true)
{
    var adSoyad = User.FindFirst(KullaniciClaimsFactory.AdSoyadClaim)?.Value ?? User.Identity.Name;
    <ul class="navbar-nav">
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                Merhaba, @adSoyad
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <form asp-area="" asp-controller="Hesap" asp-action="Cikis" method="post">
                        <button type="submit" class="dropdown-item">Çıkış Yap</button>
                    </form>
                </li>
            </ul>
        </li>
    </ul>
}
else
{
    <div class="d-flex gap-2 py-2 py-md-0">
        <a class="btn btn-outline-light btn-sm" asp-area="" asp-controller="Hesap" asp-action="Giris">Giriş Yap</a>
        <a class="btn btn-warning btn-sm" asp-area="" asp-controller="Hesap" asp-action="Kayit">Üye Ol</a>
    </div>
}
