@model SuBilet.Models.ViewModels.KayitViewModel
@{
    ViewData["Title"] = "Üye Ol";
}

<div class="container py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h1 class="h4 mb-1">Üye Ol</h1>
                    <p class="text-body-secondary small mb-4">Biletlerini tek yerden yönetmek için hesap oluştur.</p>

                    <form asp-action="Kayit" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-12 col-sm-6">
                                <label asp-for="Ad" class="form-label"></label>
                                <input asp-for="Ad" class="form-control" autocomplete="given-name" />
                                <span asp-validation-for="Ad" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label asp-for="Soyad" class="form-label"></label>
                                <input asp-for="Soyad" class="form-control" autocomplete="family-name" />
                                <span asp-validation-for="Soyad" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Eposta" class="form-label"></label>
                                <input asp-for="Eposta" class="form-control" autocomplete="email" />
                                <span asp-validation-for="Eposta" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Telefon" class="form-label"></label>
                                <input asp-for="Telefon" class="form-control" placeholder="05XX XXX XX XX" autocomplete="tel" />
                                <span asp-validation-for="Telefon" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label asp-for="Sifre" class="form-label"></label>
                                <input asp-for="Sifre" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="Sifre" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label asp-for="SifreTekrar" class="form-label"></label>
                                <input asp-for="SifreTekrar" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="SifreTekrar" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="form-text mt-2">Şifre en az 8 karakter olmalı; büyük harf, küçük harf ve rakam içermelidir.</div>

                        <button type="submit" class="btn btn-primary w-100 mt-4">Üye Ol</button>
                    </form>

                    <p class="text-center small mt-3 mb-0">
                        Zaten üye misin? <a asp-action="Giris">Giriş yap</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
